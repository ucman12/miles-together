{
  "schemaVersion": 1,
  "mode": "installed",
  "games": [{"role": "primary", "slug": "custom-marvels-spider-man-miles-morales"}],
  "components": [{"id": "main", "kind": "main", "label": "Miles Together", "fileName": "MilesTogether-*.zip", "required": true}],
  "mappings": [
    {"component": "main", "from": "winmm.dll", "to": "{game}"},
    {"component": "main", "from": "MilesTogether/", "to": "{game}/MilesTogether"}
  ],
  "requirements": [],
  "launch": {"kind": "game"},
  "multiplayer": {
    "maxPlayers": 2,
    "connect": {
      "address": {"log": "{localappdata}/MilesTogether/melty.log", "after": "Melty join address: "},
      "joinFile": {"path": "{localappdata}/MilesTogether/melty.properties", "key": "join"}
    }
  },
  "runtimeData": ["{localappdata}/MilesTogether"],
  "test": {"checks": ["hosting-open", "hero-found", "double-spawned", "pose-mirrored"], "minutes": 5}
}
